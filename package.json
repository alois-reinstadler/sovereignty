{
  "name": "svrgn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm --filter @svrgn/web build",
    "build:desktop": "pnpm --filter @svrgn/desktop build",
    "check": "pnpm --recursive --if-present check",
    "dev": "pnpm --filter @svrgn/web dev",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck"
  }
}
