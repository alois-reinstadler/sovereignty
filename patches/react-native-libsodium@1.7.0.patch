+// Unlike toArrayBuffer, zeroization must never copy a subarray.
+export function memzero(bytes: Uint8Array): void {
+  if (!(bytes instanceof Uint8Array) || !(bytes.buffer instanceof ArrayBuffer)) {
+    throw new TypeError('memzero requires an owned Uint8Array');
+  }
+  global.jsi_sodium_memzero(bytes.buffer, bytes.byteOffset, bytes.byteLength);
