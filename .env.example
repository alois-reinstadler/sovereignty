# PostgreSQL container bootstrap. Choose unique values before deployment.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Application database connection, using the PostgreSQL values above.
DATABASE_URL=

# Generate at least 32 high-entropy characters. This protects account sessions;
# it is not and must never be a vault master password.
BETTER_AUTH_SECRET=

# Exact public origin with no trailing slash, normally HTTPS.
BETTER_AUTH_URL=

# Comma-separated exact origins. Wildcards and paths are rejected.
BETTER_AUTH_TRUSTED_ORIGINS=

# Optional WebAuthn overrides. The defaults are the hostname and origin from
# BETTER_AUTH_URL. Use a stable registrable domain and HTTPS in production.
PASSKEY_RP_ID=
PASSKEY_ORIGINS=

# Account creation: closed (production default), invite-only, or open.
SIGNUP_MODE=
# Optional server-only JSON array of email/tokenHash/expiresAt invitation entries.
# Store hashes only, never raw invitation codes. See docs/SIGNUP_POLICY.md.
SIGNUP_INVITATIONS=

# Host port mapped to the application container.
SVRGN_HTTP_PORT=
